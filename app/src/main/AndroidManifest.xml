<?xml version="1.0" encoding="utf-8"?>
<!--
    Neptune Client - AndroidManifest.xml

    Permissions yang dibutuhkan:
    - SYSTEM_ALERT_WINDOW: untuk menampilkan overlay di atas Minecraft
    - FOREGROUND_SERVICE: agar overlay service tidak di-kill Android
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ─────────────────────────────────────────────────── -->

    <!-- Overlay permission (user harus grant manual di Settings) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service (wajib agar ModMenuOverlayService tetap hidup) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- POST_NOTIFICATIONS: untuk foreground service notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Application ─────────────────────────────────────────────────── -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeptuneClient"
        android:extractNativeLibs="true">

        <!-- Main launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Overlay Service -->
        <service
            android:name=".ui.ModMenuOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays Neptune Client HUD overlay above Minecraft" />
        </service>

    </application>

</manifest>
