<?xml version="1.0" encoding="utf-8"?>
<!--
    Neptune Client - mod_menu_panel.xml
    Panel overlay utama yang muncul saat tombol Neptune ditekan.
    Background semi-transparan, scroll vertikal untuk daftar fitur.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_panel_overlay"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ── Header ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Logo + Nama -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_neptune_logo"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/neptune_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <!-- Versi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:layout_marginEnd="10dp" />

            <!-- Tombol Close -->
            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/text_dim"
                android:contentDescription="Tutup menu" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="10dp" />

        <!-- ── Daftar Kategori & Fitur (scroll) ──── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="420dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <!-- ── Footer: Manage Shortcuts ──────────── -->
        <TextView
            android:id="@+id/btn_manage_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⊕  Manage Shortcuts"
            android:textColor="@color/neptune_accent"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</FrameLayout>
