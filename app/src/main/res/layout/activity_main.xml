package com.neptune.client

import android.app.AlertDialog
import android.content.Intent
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.provider.Settings
import android.widget.Toast
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AppCompatActivity
import androidx.core.app.NotificationChannelCompat
import androidx.core.app.NotificationManagerCompat
import com.neptune.client.ui.ModMenuOverlayService

/**
 * Neptune Client - MainActivity
 *
 * Activity ini hanya bertugas:
 * 1. Menampilkan info client
 * 2. Meminta permission SYSTEM_ALERT_WINDOW (overlay)
 * 3. Meminta permission POST_NOTIFICATIONS (Android 13+)
 * 4. Mengarahkan user untuk membuka Minecraft
 *
 * Saat Minecraft dibuka, ModMenuOverlayService sudah berjalan
 * dan overlay akan tampil di atasnya.
 */
class MainActivity : AppCompatActivity() {

    companion object {
        const val NOTIF_CHANNEL_ID = "neptune_service"
        const val OVERLAY_REQUEST_CODE = 1001
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        setupNotificationChannel()
        checkAndRequestPermissions()
    }

    // ── Permission Flow ────────────────────────────────────────────────────

    private fun checkAndRequestPermissions() {
        when {
            !hasOverlayPermission() -> requestOverlayPermission()
            !hasNotifPermission()   -> requestNotifPermission()
            else                    -> onAllPermissionsGranted()
        }
    }

    private fun hasOverlayPermission(): Boolean =
        Settings.canDrawOverlays(this)

    private fun hasNotifPermission(): Boolean {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return true
        return NotificationManagerCompat.from(this).areNotificationsEnabled()
    }

    private fun requestOverlayPermission() {
        AlertDialog.Builder(this)
            .setTitle("Izin Overlay Diperlukan")
            .setMessage(
                "Neptune Client perlu izin 'Display over other apps' agar bisa " +
                "menampilkan HUD dan Mod Menu di atas Minecraft.\n\n" +
                "Tap OK lalu aktifkan toggle untuk Neptune Client."
            )
            .setPositiveButton("Buka Pengaturan") { _, _ ->
                val intent = Intent(
                    Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                    Uri.parse("package:$packageName")
                )
                startActivityForResult(intent, OVERLAY_REQUEST_CODE)
            }
            .setCancelable(false)
            .show()
    }

    private val notifPermLauncher = registerForActivityResult(
        ActivityResultContracts.RequestPermission()
    ) { granted ->
        if (granted) onAllPermissionsGranted()
        else {
            Toast.makeText(this,
                "Notifikasi diperlukan untuk menjalankan service overlay",
                Toast.LENGTH_LONG).show()
        }
    }

    private fun requestNotifPermission() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            notifPermLauncher.launch(android.Manifest.permission.POST_NOTIFICATIONS)
        }
    }

    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        super.onActivityResult(requestCode, resultCode, data)
        if (requestCode == OVERLAY_REQUEST_CODE) {
            if (hasOverlayPermission()) {
                checkAndRequestPermissions()
            } else {
                Toast.makeText(this, "Overlay permission diperlukan!", Toast.LENGTH_SHORT).show()
            }
        }
    }

    // ── Service Launch ─────────────────────────────────────────────────────

    private fun onAllPermissionsGranted() {
        startOverlayService()
        showReadyDialog()
    }

    private fun startOverlayService() {
        val serviceIntent = Intent(this, ModMenuOverlayService::class.java)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            startForegroundService(serviceIntent)
        } else {
            startService(serviceIntent)
        }
    }

    private fun showReadyDialog() {
        AlertDialog.Builder(this)
            .setTitle("Neptune Client Aktif ✓")
            .setMessage(
                "Overlay service sudah berjalan.\n\n" +
                "Sekarang buka Minecraft Bedrock, lalu tap ikon Neptune " +
                "di pojok layar untuk membuka Mod Menu."
            )
            .setPositiveButton("Buka Minecraft") { _, _ ->
                launchMinecraft()
            }
            .setNeutralButton("Nanti") { d, _ -> d.dismiss() }
            .show()
    }

    private fun launchMinecraft() {
        val mcPackages = listOf(
            "com.mojang.minecraftpe",           // Minecraft standard
            "com.mojang.minecraftpe.earlyaccess" // Beta/Preview
        )
        for (pkg in mcPackages) {
            val intent = packageManager.getLaunchIntentForPackage(pkg)
            if (intent != null) {
                startActivity(intent)
                return
            }
        }
        Toast.makeText(this, "Minecraft tidak ditemukan di perangkat ini", Toast.LENGTH_LONG).show()
    }

    // ── Notification Channel ───────────────────────────────────────────────

    private fun setupNotificationChannel() {
        val channel = NotificationChannelCompat.Builder(
            NOTIF_CHANNEL_ID,
            NotificationManagerCompat.IMPORTANCE_LOW
        )
            .setName("Neptune Client Service")
            .setDescription("Digunakan untuk menjalankan overlay HUD di background")
            .setShowBadge(false)
            .build()

        NotificationManagerCompat.from(this).createNotificationChannel(channel)
    }
}
